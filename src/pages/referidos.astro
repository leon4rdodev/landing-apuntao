---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Gana con Apunta'o - Programa de Referidos" description="Gana hasta $12 USD por cada referido en Apunta'o. Refiere a otros dueños de negocios y recibe el 40% de su suscripción. Sin límite de referidos. ¡Únete ahora!">
	<Header active="gana" />
	<div class="orb orb--top-left"></div>
	<div class="orb orb--bottom-right"></div>

	<main>
		<section class="hero">
			<div class="hero-icon">
				<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
			</div>
			<h1 class="hero-title">
				Gana con <span class="text-primary">Apunta'o</span>
			</h1>
			<p class="hero-subtitle">
				Refiere a otros dueños de colmados y gana el <strong>40%</strong> del primer pago de su suscripción.
			</p>
		</section>

		<section class="steps">
			<h2 class="section-title">¿Cómo funciona?</h2>

			<div class="step-card">
				<div class="step-number">1</div>
				<div class="step-content">
					<strong>Comparte tu código</strong>
					<span>Invita a otros dueños de colmados a usar Apunta'o. Comparte tu enlace o código de referido por WhatsApp.</span>
				</div>
			</div>

			<div class="step-card">
				<div class="step-number">2</div>
				<div class="step-content">
					<strong>Se registran y eligen un plan</strong>
					<span>La persona ingresa tu código al registrarse y compra cualquier plan (Mensual, Trimestral o Anual).</span>
				</div>
			</div>

			<div class="step-card">
				<div class="step-number">3</div>
				<div class="step-content">
					<strong>Ganas el 40%</strong>
					<span>Recibes el 40% del valor del primer pago de su suscripción. Te lo depositamos directo.</span>
				</div>
			</div>
		</section>

		<section class="examples">
			<h2 class="section-title">Ganancias ejemplo</h2>
			<p class="section-subtitle">Por cada referido que compre su primer plan:</p>

			<div class="example-card">
				<div class="example-row">
					<span class="example-label">Plan Mensual ($3.99 USD)</span>
					<span class="example-value">Ganas <strong>$1.60 USD</strong></span>
				</div>
				<div class="example-row">
					<span class="example-label">Plan Trimestral ($9.99 USD)</span>
					<span class="example-value">Ganas <strong>$4.00 USD</strong></span>
				</div>
				<div class="example-row example-row--featured">
					<span class="example-label">Plan Anual ($29.99 USD)</span>
					<span class="example-value">Ganas <strong>$12.00 USD</strong></span>
				</div>
			</div>

			<p class="examples-note">Sin límite. Refiere a 10 personas en plan anual y te llevas <strong>$120 USD</strong>.</p>
		</section>

		<section class="cta">
			<h2 class="cta-title">¿Conoces dueños de tiendas, colmados o negocios?</h2>
			<a href="https://wa.me/18493759671?text=Hola%2C%20quiero%20participar%20en%20el%20programa%20de%20referidos%20de%20Apunta%27o." class="btn-download" target="_blank" rel="noopener">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
				Quiero participar
			</a>
		</section>
	</main>

	<footer class="footer">
		<div class="footer-links">
			<a href="/" class="footer-link">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
				Inicio
			</a>
			<a href="https://wa.me/18493759671" class="footer-link" target="_blank" rel="noopener">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
				Soporte
			</a>
			<a href="mailto:apuntaord@gmail.com" class="footer-link">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
				apuntaord@gmail.com
			</a>
		</div>
		<p class="footer-copy">© 2026 Apunta'o. Hecho para dueños de negocios.</p>
	</footer>
</Layout>

<style>
	.orb {
		position: fixed;
		border-radius: 50%;
		pointer-events: none;
		z-index: 0;
	}
	.orb--top-left {
		top: -160px;
		left: -160px;
		width: 400px;
		height: 400px;
		background: var(--primary);
		opacity: 0.06;
	}
	.orb--bottom-right {
		bottom: -160px;
		right: -160px;
		width: 400px;
		height: 400px;
		background: var(--primary);
		opacity: 0.06;
	}

	.hero {
		text-align: center;
		padding: 32px 24px 24px;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}
	.hero-icon {
		width: 72px;
		height: 72px;
		border-radius: 50%;
		background: var(--primary);
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 20px;
		color: white;
	}
	.hero-title {
		font-size: 32px;
		font-weight: 900;
		line-height: 1.15;
		margin: 0 0 12px;
		letter-spacing: -1px;
	}
	.text-primary { color: var(--primary); }
	.hero-subtitle {
		font-size: 17px;
		line-height: 1.6;
		color: var(--text-secondary);
		margin: 0 auto;
		max-width: 420px;
	}

	.section-title {
		font-size: 24px;
		font-weight: 900;
		text-align: center;
		margin: 0 0 24px;
		letter-spacing: -0.5px;
	}
	.section-subtitle {
		font-size: 15px;
		color: var(--text-secondary);
		text-align: center;
		margin: -16px auto 24px;
		max-width: 360px;
		line-height: 1.5;
	}

	.steps {
		padding: 32px 24px;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}
	.step-card {
		display: flex;
		gap: 16px;
		align-items: flex-start;
		padding: 20px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		margin-bottom: 12px;
	}
	.step-number {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--primary);
		color: white;
		font-weight: 900;
		font-size: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.step-content {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.step-content strong {
		font-size: 16px;
		font-weight: 700;
	}
	.step-content span {
		font-size: 14px;
		line-height: 1.5;
		color: var(--text-secondary);
	}

	.examples {
		padding: 24px 24px 32px;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}
	.example-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
	}
	.example-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 16px 20px;
		border-bottom: 1px solid var(--border-subtle);
	}
	.example-row:last-child { border-bottom: none; }
	.example-row--featured {
		background: var(--primary-light);
	}
	.example-label {
		font-size: 15px;
		color: var(--text);
	}
	.example-value {
		font-size: 16px;
		color: var(--text);
	}
	.example-value strong {
		color: var(--primary);
		font-weight: 800;
	}
	.examples-note {
		font-size: 14px;
		text-align: center;
		color: var(--text-secondary);
		margin: 16px 0 0;
		line-height: 1.5;
	}

	.cta {
		text-align: center;
		padding: 8px 24px 48px;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}
	.cta-title {
		font-size: 22px;
		font-weight: 800;
		margin: 0 0 24px;
		letter-spacing: -0.5px;
	}

	.btn-download {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 16px 36px;
		background: var(--primary);
		color: white;
		border: none;
		border-radius: 100px;
		font-weight: 700;
		font-size: 17px;
		font-family: inherit;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow: 0 4px 16px rgba(22, 163, 74, 0.3);
	}
	.btn-download:hover {
		background: var(--primary-dark);
		transform: translateY(-2px);
		box-shadow: 0 6px 24px rgba(22, 163, 74, 0.35);
	}

	.footer {
		text-align: center;
		padding: 32px 24px 40px;
		max-width: 1200px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
		border-top: 1px solid var(--border);
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 20px;
		margin-bottom: 16px;
		flex-wrap: wrap;
	}
	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s;
	}
	.footer-link:hover { color: var(--primary); }
	.footer-copy {
		font-size: 12px;
		color: var(--text-secondary);
		margin: 0;
		opacity: 0.6;
	}

	@media (max-width: 359px) {
		.hero { padding: 24px 16px; }
		.hero-title { font-size: 24px; }
		.hero-subtitle { font-size: 15px; }
		.hero-icon { width: 56px; height: 56px; }
		.hero-icon svg { width: 28px; height: 28px; }
		.steps { padding: 24px 16px; }
		.step-card { padding: 16px; gap: 12px; }
		.step-number { width: 30px; height: 30px; font-size: 14px; }
		.step-content strong { font-size: 14px; }
		.step-content span { font-size: 13px; }
		.examples { padding: 16px 16px 24px; }
		.example-row { padding: 12px 16px; flex-direction: column; gap: 4px; align-items: flex-start; }
		.section-title { font-size: 20px; }
		.cta-title { font-size: 18px; }
		.cta { padding: 8px 16px 32px; }
		.btn-download { padding: 14px 24px; font-size: 15px; width: 100%; justify-content: center; }
		.footer { padding: 24px 16px 32px; }
		.footer-links { flex-direction: column; align-items: center; gap: 12px; }
		.orb--top-left { width: 200px; height: 200px; top: -80px; left: -80px; }
		.orb--bottom-right { width: 200px; height: 200px; bottom: -80px; right: -80px; }
	}

	@media (min-width: 360px) and (max-width: 639px) {
		.hero { padding: 32px 20px 24px; }
		.hero-title { font-size: 28px; }
		.hero-subtitle { font-size: 16px; }
		.steps { padding: 32px 20px; }
		.examples { padding: 24px 20px 32px; }
		.cta { padding: 16px 20px 40px; }
		.cta .btn-download { width: 100%; justify-content: center; }
		.footer { padding: 28px 20px 36px; }
		.footer-links { flex-direction: column; align-items: center; gap: 12px; }
	}

	@media (min-width: 640px) {
		.hero { padding: 48px 32px 32px; }
		.hero-title { font-size: 40px; }
		.hero-icon { width: 80px; height: 80px; }
		.hero-icon svg { width: 40px; height: 40px; }
		.hero-subtitle { font-size: 18px; max-width: 500px; }
		.steps { max-width: 560px; padding: 40px 32px; }
		.step-card { padding: 24px; }
		.section-title { font-size: 28px; }
		.examples { max-width: 560px; padding: 24px 32px 40px; }
		.example-row { padding: 18px 24px; }
		.example-label { font-size: 16px; }
		.example-value { font-size: 17px; }
		.examples-note { font-size: 15px; }
		.cta-title { font-size: 26px; }
		.cta { padding: 16px 32px 56px; }
		.footer { padding: 36px 32px 44px; }
		.orb--top-left { width: 500px; height: 500px; top: -200px; left: -200px; }
		.orb--bottom-right { width: 500px; height: 500px; bottom: -200px; right: -200px; }
	}

	@media (min-width: 768px) {
		.hero { padding: 64px 40px 40px; }
		.hero-title { font-size: 44px; }
		.steps { max-width: 640px; padding: 48px 40px; }
		.section-title { font-size: 30px; }
		.examples { max-width: 640px; padding: 32px 40px 48px; }
		.cta-title { font-size: 28px; }
		.cta { padding: 24px 40px 64px; }
		.footer { padding: 40px 40px 48px; }
	}

	@media (min-width: 1024px) {
		.hero { padding: 80px 48px 48px; }
		.hero-title { font-size: 48px; }
		.hero-subtitle { font-size: 19px; max-width: 560px; }
		.steps { max-width: 720px; padding: 56px 48px; }
		.section-title { font-size: 32px; }
		.step-card { padding: 28px; }
		.examples { max-width: 720px; padding: 40px 48px 56px; }
		.cta-title { font-size: 30px; }
		.cta { padding: 32px 48px 72px; }
		.footer { padding: 44px 48px 52px; }
		.orb--top-left { width: 600px; height: 600px; top: -240px; left: -240px; }
		.orb--bottom-right { width: 600px; height: 600px; bottom: -240px; right: -240px; }
	}

	@media (min-width: 1280px) {
		.hero-title { font-size: 52px; }
		.steps { max-width: 800px; }
		.examples { max-width: 720px; }
		.hero,
		.steps,
		.examples,
		.cta,
		.footer { margin-left: auto; margin-right: auto; }
	}

	@media (min-width: 1440px) {
		.hero { padding: 100px 0 56px; }
		.hero-title { font-size: 56px; }
		.steps { padding: 64px 0; }
		.examples { padding: 48px 0 64px; }
		.cta { padding: 40px 0 80px; }
		.footer { padding: 48px 0 56px; }
	}
</style>
