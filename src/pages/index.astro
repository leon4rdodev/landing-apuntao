<style>
	/* --- ORBES DECORATIVOS --- */
	.orb {
		position: fixed;
		border-radius: 50%;
		pointer-events: none;
		z-index: 0;
	}
	.orb--top-left {
		top: -160px;
		left: -160px;
		width: 400px;
		height: 400px;
		background: var(--primary);
		opacity: 0.06;
	}
	.orb--bottom-right {
		bottom: -160px;
		right: -160px;
		width: 400px;
		height: 400px;
		background: var(--primary);
		opacity: 0.06;
	}

	/* --- HERO --- */
	.hero {
		text-align: center;
		padding: 32px 24px;
		position: relative;
		z-index: 1;
	}
	.hero-title {
		font-size: 36px;
		font-weight: 900;
		line-height: 1.15;
		margin: 0 0 16px;
		letter-spacing: -1px;
		max-width: 480px;
		margin-left: auto;
		margin-right: auto;
	}
	.text-primary {
		color: var(--primary);
	}
	.hero-subtitle {
		font-size: 17px;
		line-height: 1.6;
		color: var(--text-secondary);
		margin: 0 auto 32px;
		max-width: 420px;
	}
	.hero-meta {
		font-size: 13px;
		color: var(--text-secondary);
		margin: 20px 0 0;
		opacity: 0.7;
	}

