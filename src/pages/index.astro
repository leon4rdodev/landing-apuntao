---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Apunta'o - Descarga la App">
	<Header active="inicio" />
	<div class="orb orb--top-left"></div>
	<div class="orb orb--bottom-right"></div>

	<main>
		<section class="hero">
			<h1 class="hero-title">
				Adiós al <span class="text-primary">Caos del Papel</span>
			</h1>
			<p class="hero-subtitle">
				Digitaliza tu cuaderno de fiado y recupera la tranquilidad. Maneja tus cuentas con precisión profesional.
			</p>

			<a href="/apuntao.apk" class="btn-download" download>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
				Descargar APK
			</a>

			<p class="hero-meta">7 días gratis · Sin publicidad · 100% offline</p>
		</section>

		<section class="features">
			<div class="feature-card">
				<div class="feature-icon">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
				</div>
				<div class="feature-text">
					<strong>Registro Inteligente</strong>
					<span>Crea perfiles para tus clientes y mantén su historial de pagos bajo control.</span>
				</div>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
				</div>
				<div class="feature-text">
					<strong>Balance al Instante</strong>
					<span>Apunta deudas y abonos en segundos. La app calcula los totales automáticamente.</span>
				</div>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
				</div>
				<div class="feature-text">
					<strong>Cobros Efectivos</strong>
					<span>Envía estados de cuenta por WhatsApp con un solo toque. Más profesional.</span>
				</div>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/><circle cx="12" cy="10" r="3"/></svg>
				</div>
				<div class="feature-text">
					<strong>Respaldo Infinito</strong>
					<span>Tus datos se guardan automáticamente en la nube. Cambia de teléfono sin miedo.</span>
				</div>
			</div>
		</section>

		<section class="referral">
